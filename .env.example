# ============================================================
# ZTForensics Environment Configuration Template
# Copy this file to .env and fill in your values.
# ============================================================

# ------------------------------------------------------------
# Keycloak Configuration
# ------------------------------------------------------------
KEYCLOAK_SERVER_URL=http://localhost:8080
KEYCLOAK_REALM=forensics
KEYCLOAK_CLIENT_ID=api-gateway
KEYCLOAK_CLIENT_SECRET=3spkr3Fjhf9HcXivHWMRFqKdLehSoKLC
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=admin123

# ------------------------------------------------------------
# API Gateway
# ------------------------------------------------------------
API_GATEWAY_HOST=0.0.0.0
API_GATEWAY_PORT=8000
API_GATEWAY_LOG_LEVEL=INFO
JWT_ALGORITHM=RS256
TOKEN_EXPIRATION=3600

# ------------------------------------------------------------
# Database
# ------------------------------------------------------------
DATABASE_URL=postgresql://ztf:ztfpass@ztf-postgres:5432/ztfdb
DATABASE_POOL_SIZE=10
DATABASE_POOL_RECYCLE=3600

# ------------------------------------------------------------
# MinIO Object Storage
# ------------------------------------------------------------
MINIO_ENDPOINT=ztf-minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_BUCKET=forensics-evidence

# ------------------------------------------------------------
# OPA Policy Engine
# ------------------------------------------------------------
OPA_URL=http://ztf-opa:8181
OPA_POLICY_PATH=/policies

# ------------------------------------------------------------
# Dashboard
# ------------------------------------------------------------
DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=5000
API_GATEWAY_URL=http://ztf-api:8000
KEYCLOAK_LOGIN_URL=http://localhost:8080/realms/forensics/protocol/openid-connect/auth

# ------------------------------------------------------------
# Security
# ------------------------------------------------------------
# IMPORTANT: Change SECRET_KEY before deploying to production!
SECRET_KEY=your-secret-key-change-in-production
DEBUG=False
CORS_ORIGINS=http://localhost:5000,http://localhost:8000

# ------------------------------------------------------------
# Logging
# ------------------------------------------------------------
LOG_LEVEL=INFO
LOG_FORMAT=json
