@app.get("/admin/whitelist/locations")
async def admin_list_whitelist_locations(
    user: UserContext = Depends(get_current_user),
    db: Session = Depends(get_db),
) -> dict[str, Any]:
    _require_admin(user)
    now = datetime.utcnow()
    rows = db.query(WhitelistLocation).order_by(WhitelistLocation.created_at.desc()).all()

    data = []
    for r in rows:
        expires_at = getattr(r, "expires_at", None)
        is_temp = bool(expires_at)
        is_expired = bool(expires_at and expires_at < now)
        data.append(
            {
                "id": r.id,
                "name": r.name,
                "ip_range": r.ip_range,
                "location": r.location,
                "is_active": r.is_active,
                "is_temporary": is_temp,
                "expires_at": expires_at.isoformat() if expires_at else None,
                "is_expired": is_expired,
                "created_at": r.created_at.isoformat() if r.created_at else None,
                "created_by": r.created_by,
            }
        )

    return {"total": len(data), "locations": data}


