# Routes
# ---------------------------------------------------------------------------

@app.get("/")
async def root() -> dict[str, str]:
    return {"message": "ZTForensics API Gateway", "version": "1.1.0"}


@app.get("/health")
async def health(db: Session = Depends(get_db)) -> dict[str, Any]:
    db_status = "up"
    try:
        db.execute(__import__("sqlalchemy").text("SELECT 1"))
    except Exception:
        db_status = "down"

    storage_status = "up" if storage_manager is not None else "down"

    return {
        "status": "healthy",
        "services": {
            "database": db_status,
            "blockchain": "up",
            "storage": storage_status,
        },
    }


@app.get("/forensics/summary-public")
async def forensics_summary_public(db: Session = Depends(get_db)) -> dict[str, Any]:
    from sqlalchemy import func

    total = db.query(func.count(AccessLog.id)).scalar() or 0
    allowed = db.query(func.count(AccessLog.id)).filter(AccessLog.decision == "allow").scalar() or 0
    challenged = db.query(func.count(AccessLog.id)).filter(AccessLog.decision == "challenge_otp").scalar() or 0
    denied = db.query(func.count(AccessLog.id)).filter(AccessLog.decision == "deny").scalar() or 0

    logs = db.query(AccessLog.risk_score).all()
    high_risk = sum(1 for (s,) in logs if _is_high_risk(float(s or 0.0)))

    open_alerts = db.query(func.count(SecurityAlert.id)).filter(SecurityAlert.status == "open").scalar() or 0

    recent_logs = db.query(AccessLog).order_by(AccessLog.timestamp.desc()).limit(10).all()
    recent = [
        {
            "id": log.id,
            "timestamp": log.timestamp.isoformat() if log.timestamp else None,
            "user_id": log.user_id,
            "resource": log.resource,
            "action": log.action,
            "decision": log.decision,
            "risk_score": log.risk_score,
        }
        for log in recent_logs
    ]

    return {
        "total_requests": total,
        "allowed": allowed,
        "challenge_otp": challenged,
        "denied": denied,
        "high_risk_events": high_risk,
        "open_security_alerts": open_alerts,
        "recent_logs": recent,
    }


@app.post("/otp/send")
async def otp_send(payload: OTPSendRequest, db: Session = Depends(get_db)) -> dict[str, Any]:
    """Issue OTP only for allowed step-up flow."""
    otp_code = _generate_otp_code()
    expires_at = datetime.utcnow() + timedelta(minutes=OTP_EXPIRY_MINUTES)

    row = OTPChallenge(
        user_id=payload.user_id,
        resource=payload.resource,
        action=payload.action,
        ip_address=payload.ip_address,
        otp_code=otp_code,
        status="pending",
        attempts=0,
        max_attempts=OTP_MAX_ATTEMPTS,
        expires_at=expires_at,
        metadata_json=json.dumps(payload.metadata or {}),
    )
    db.add(row)
    db.commit()
    db.refresh(row)

    logger.info("OTP issued challenge_id=%s user=%s otp=%s", row.id, row.user_id, otp_code)

    return {
        "ok": True,
        "challenge_id": row.id,
        "expires_at": row.expires_at.isoformat(),
        "message": "OTP sent to employee registered channel.",
    }


@app.post("/otp/verify")
async def otp_verify(payload: OTPVerifyRequest, db: Session = Depends(get_db)) -> dict[str, Any]:
    row = db.query(OTPChallenge).filter(OTPChallenge.id == payload.challenge_id).first()
    if not row:
        raise HTTPException(status_code=404, detail="OTP challenge not found")

    if row.user_id != payload.user_id:
        raise HTTPException(status_code=403, detail="Challenge does not belong to this user")

    now = datetime.utcnow()

    if row.status != "pending":
        raise HTTPException(status_code=400, detail=f"Challenge is {row.status}")

    if row.expires_at < now:
        row.status = "expired"
        db.commit()
        raise HTTPException(status_code=400, detail="OTP expired")

    if row.attempts >= row.max_attempts:
        row.status = "failed"
        db.commit()
        raise HTTPException(status_code=429, detail="Maximum OTP attempts exceeded")

    row.attempts += 1

    if payload.otp_code != row.otp_code:
        if row.attempts >= row.max_attempts:
            row.status = "failed"
        db.commit()
        raise HTTPException(status_code=401, detail="Invalid OTP")

    row.status = "verified"
    row.verified_at = now
    db.commit()

    return {
        "ok": True,
        "decision": "allow",
        "message": "OTP verified. Access can be allowed.",
        "challenge_id": row.id,
    }


@app.get("/security/alerts")
async def list_security_alerts(
    limit: int = Query(50, ge=1, le=500),
    user: UserContext = Depends(get_current_user),
    db: Session = Depends(get_db),
) -> dict[str, Any]:
    _require_admin(user)
    rows = db.query(SecurityAlert).order_by(SecurityAlert.created_at.desc()).limit(limit).all()
    return {
        "total": len(rows),
        "alerts": [
            {
                "id": r.id,
                "user_id": r.user_id,
                "alert_type": r.alert_type,
                "severity": r.severity,
                "decision": r.decision,
                "reason": r.reason,
                "resource": r.resource,
                "action": r.action,
                "ip_address": r.ip_address,
                "status": r.status,
                "details_json": r.details_json,
                "created_at": r.created_at.isoformat() if r.created_at else None,
            }
            for r in rows
        ],
    }


@app.post("/access", response_model=AccessResponse)
async def access(request: AccessRequest, db: Session = Depends(get_db)) -> AccessResponse:
    computed_risk = risk_scorer.calculate_risk(
        {
            "ip_address": request.ip_address,
            "user_agent": request.user_agent,
            "resource": request.resource,
            "action": request.action,
            "user_id": request.user_id,
        }
    )

    provided_risk = float((request.metadata or {}).get("risk_score", 0.0) or 0.0)
    risk_score = max(float(computed_risk), provided_risk)

    opa_result = await _query_opa(request, normalized_risk=risk_score)

    decision = str(opa_result.get("decision", "deny")).lower()
    reason = str(opa_result.get("reason", "POLICY_DECISION"))

    if decision not in {"allow", "deny", "challenge_otp"}:
        allow_bool = bool(opa_result.get("allow", False))
        decision = "allow" if allow_bool else "deny"
        if reason == "POLICY_DECISION":
            reason = "ALLOWED_BY_POLICY" if allow_bool else "DENIED_BY_POLICY"

    otp_challenge_id: Optional[int] = None

    if decision == "challenge_otp":
        otp_code = _generate_otp_code()
        expires_at = datetime.utcnow() + timedelta(minutes=OTP_EXPIRY_MINUTES)

        otp_row = OTPChallenge(
            user_id=request.user_id,
            resource=request.resource,
            action=request.action,
            ip_address=request.ip_address,
            otp_code=otp_code,
            status="pending",
            attempts=0,
            max_attempts=OTP_MAX_ATTEMPTS,
            expires_at=expires_at,
            metadata_json=json.dumps(request.metadata or {}),
        )
        db.add(otp_row)
        db.commit()
        db.refresh(otp_row)
        otp_challenge_id = otp_row.id

        logger.info(
            "OTP challenge created: id=%s user=%s otp=%s",
            otp_row.id, otp_row.user_id, otp_code
        )

    if decision == "deny":
        risk_scorer.record_failure(request.user_id)
        _create_security_alert(
            db=db,
            user_id=request.user_id,
            reason=reason,
            resource=request.resource,
            action=request.action,
            ip_address=request.ip_address,
            decision=decision,
            risk_score=risk_score,
            metadata=request.metadata or {},
        )

    log_entry = {
        "user_id": request.user_id,
        "resource": request.resource,
        "action": request.action,
        "decision": decision,
        "risk_score": risk_score,
        "ip_address": request.ip_address,
        "user_agent": request.user_agent,
        "reason": reason,
        "otp_challenge_id": otp_challenge_id,
        "timestamp": datetime.now(timezone.utc).isoformat(),
    }
    chain_hash = blockchain_manager.add_block(log_entry)

    access_log = AccessLog(
        user_id=request.user_id,
        resource=request.resource,
        action=request.action,
        decision=decision,
        risk_score=risk_score,
        ip_address=request.ip_address,
        user_agent=request.user_agent,
        chain_hash=chain_hash,
    )
    db.add(access_log)
    db.commit()

    logger.info(
        "Access decision=%s user=%s resource=%s action=%s risk=%.2f reason=%s",
        decision, request.user_id, request.resource, request.action, risk_score, reason
    )

    return AccessResponse(
        decision=decision,
        risk_score=risk_score,
        reason=reason,
        chain_hash=chain_hash,
        otp_challenge_id=otp_challenge_id,
    )


@app.get("/forensics/verify-chain")
async def verify_chain(_user: UserContext = Depends(get_current_user)) -> dict[str, Any]:
    result = blockchain_manager.verify_chain()
    stats = blockchain_manager.get_chain_stats()
