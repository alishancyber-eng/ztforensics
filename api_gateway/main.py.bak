@app.post("/admin/whitelist/temporary")
async def admin_create_temporary_whitelist(
    payload: AdminTempWhitelistCreate,
    user: UserContext = Depends(get_current_user),
    db: Session = Depends(get_db),
) -> dict[str, Any]:
    _require_admin(user)

    expires_at = datetime.utcnow() + timedelta(days=payload.expires_in_days)

    if payload.kind == "location":
        if not payload.ip_range or not payload.location:
            raise HTTPException(status_code=400, detail="ip_range and location required for temporary location whitelist")

        row = WhitelistLocation(
            name=payload.name,
            ip_range=payload.ip_range,
            location=payload.location,
            is_active=True,
            created_by=user.user_id,
        )
        # compatibility: only set if DB model has expires_at column
        if hasattr(row, "expires_at"):
            setattr(row, "expires_at", expires_at)

        db.add(row)
        db.commit()
        db.refresh(row)

        _admin_audit(
            db=db,
            actor_user_id=user.user_id,
            action="CREATE_TEMP_WHITELIST_LOCATION",
            target_type="whitelist_location",
            target_id=str(row.id),
            details={"name": row.name, "expires_at": expires_at.isoformat()},
        )

        return {
            "ok": True,
            "temporary_whitelist": {
                "kind": "location",
                "id": row.id,
                "name": row.name,
                "ip_range": row.ip_range,
                "location": row.location,
                "expires_at": expires_at.isoformat(),
            },
        }

    if not payload.user_id or not payload.device_name:
        raise HTTPException(status_code=400, detail="user_id and device_name required for temporary device whitelist")

    row = WhitelistDevice(
        user_id=payload.user_id,
        device_name=payload.device_name,
        is_active=True,
        created_by=user.user_id,
    )
    if hasattr(row, "expires_at"):
        setattr(row, "expires_at", expires_at)

    db.add(row)
    db.commit()
    db.refresh(row)

    _admin_audit(
        db=db,
        actor_user_id=user.user_id,
        action="CREATE_TEMP_WHITELIST_DEVICE",
        target_type="whitelist_device",
        target_id=str(row.id),
        details={"user_id": row.user_id, "device_name": row.device_name, "expires_at": expires_at.isoformat()},
    )

    return {
        "ok": True,
        "temporary_whitelist": {
            "kind": "device",
            "id": row.id,
            "user_id": row.user_id,
            "device_name": row.device_name,
            "expires_at": expires_at.isoformat(),
        },
    }


@app.get("/admin/audit")
async def admin_audit_list(
    limit: int = Query(50, ge=1, le=500),
    user: UserContext = Depends(get_current_user),
    db: Session = Depends(get_db),
) -> dict[str, Any]:
    _require_admin(user)
    rows = db.query(AdminAuditLog).order_by(AdminAuditLog.created_at.desc()).limit(limit).all()
    return {
        "total": len(rows),
        "events": [
            {
                "id": r.id,
                "actor_user_id": r.actor_user_id,
                "action": r.action,
                "target_type": r.target_type,
                "target_id": r.target_id,
                "details_json": r.details_json,
                "created_at": r.created_at.isoformat() if r.created_at else None,
            }
            for r in rows
        ],
    }