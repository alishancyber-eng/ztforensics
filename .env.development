# ============================================================
# ZTForensics – Development Environment
# ============================================================

# Keycloak Configuration
KEYCLOAK_SERVER_URL=http://localhost:8080
KEYCLOAK_REALM=forensics
KEYCLOAK_CLIENT_ID=api-gateway
KEYCLOAK_CLIENT_SECRET=3spkr3Fjhf9HcXivHWMRFqKdLehSoKLC
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=admin123

# API Gateway
API_GATEWAY_HOST=0.0.0.0
API_GATEWAY_PORT=8000
API_GATEWAY_LOG_LEVEL=DEBUG
JWT_ALGORITHM=RS256
TOKEN_EXPIRATION=3600

# Database
DATABASE_URL=postgresql://ztf:ztfpass@ztf-postgres:5432/ztfdb
DATABASE_POOL_SIZE=5
DATABASE_POOL_RECYCLE=3600

# MinIO Object Storage
MINIO_ENDPOINT=ztf-minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_BUCKET=forensics-evidence

# OPA Policy Engine
OPA_URL=http://ztf-opa:8181
OPA_POLICY_PATH=/policies

# Dashboard
DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=5000
API_GATEWAY_URL=http://ztf-api:8000
KEYCLOAK_LOGIN_URL=http://localhost:8080/realms/forensics/protocol/openid-connect/auth

# Security – relaxed for development
SECRET_KEY=dev-secret-key-not-for-production
DEBUG=True
CORS_ORIGINS=*

# Logging – verbose in development
LOG_LEVEL=DEBUG
LOG_FORMAT=text
