{% extends "base.html" %}
{% block title %}ZTForensics — Configuration{% endblock %}

{% block content %}
<h1>⚙️ Environment Configuration</h1>

<div class="card">
  <h2>Authorization</h2>
  <p style="font-size:.9rem;color:#4a5568;margin-bottom:.6rem;">
    This page reads <code>/config/current</code> using the session token from navbar.
  </p>
  <button onclick="openTokenPrompt()" style="padding:.45rem .8rem;">Set / Replace Token</button>
  <button onclick="clearSessionToken()" style="padding:.45rem .8rem;margin-left:.4rem;">Logout Token</button>
  <button onclick="window.location.reload()" style="padding:.45rem .8rem;margin-left:.4rem;">Reload Config</button>
</div>

<div class="card mt">
  <h2>Current Config</h2>
  {% if config_data.get('auth_required') %}
    <p style="color:#c53030;">Authentication required to view config. Use top-right "Set Token".</p>
  {% elif config_data.get('ok') is sameas false and config_data.get('error') %}
    <p style="color:#c53030;">Error: {{ config_data.get('error') }}</p>
  {% else %}
    <table>
      <tbody>
        <tr><td><strong>Environment</strong></td><td>{{ config_data.get('environment', '—') }}</td></tr>
        <tr><td><strong>Organization</strong></td><td>{{ config_data.get('organization', '—') }}</td></tr>
        <tr><td><strong>Sector</strong></td><td>{{ config_data.get('sector', '—') }}</td></tr>
        <tr><td><strong>Audit Retention</strong></td><td>{{ config_data.get('audit_retention_days', '—') }} days</td></tr>
        <tr><td><strong>HIPAA</strong></td><td>{{ config_data.get('hipaa_compliant', '—') }}</td></tr>
        <tr><td><strong>PCI</strong></td><td>{{ config_data.get('pci_compliant', '—') }}</td></tr>
      </tbody>
    </table>

    <h2 style="margin-top:1rem;">Thresholds</h2>
    <table>
      <tbody>
        <tr><td>Low</td><td>{{ config_data.get('thresholds', {}).get('low', '—') }}</td></tr>
        <tr><td>Medium</td><td>{{ config_data.get('thresholds', {}).get('medium', '—') }}</td></tr>
        <tr><td>High</td><td>{{ config_data.get('thresholds', {}).get('high', '—') }}</td></tr>
        <tr><td>Critical</td><td>{{ config_data.get('thresholds', {}).get('critical', '—') }}</td></tr>
      </tbody>
    </table>
  {% endif %}
</div>
{% endblock %}