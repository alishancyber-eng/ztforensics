# ============================================================
# ZTForensics – Test Environment
# Uses lightweight mock/in-memory backends for fast test runs.
# ============================================================

# Keycloak – points to a local mock OIDC server (e.g. keycloak-mock or oauth2-proxy)
KEYCLOAK_SERVER_URL=http://localhost:8888
KEYCLOAK_REALM=forensics
KEYCLOAK_CLIENT_ID=api-gateway
KEYCLOAK_CLIENT_SECRET=test-secret
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=admin

# API Gateway
API_GATEWAY_HOST=0.0.0.0
API_GATEWAY_PORT=8000
API_GATEWAY_LOG_LEVEL=DEBUG
JWT_ALGORITHM=RS256
TOKEN_EXPIRATION=300

# Database – in-memory SQLite for fast, isolated tests
DATABASE_URL=sqlite:///:memory:
DATABASE_POOL_SIZE=1
DATABASE_POOL_RECYCLE=0

# MinIO – disabled / mocked in tests
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=testaccess
MINIO_SECRET_KEY=testsecret
MINIO_BUCKET=test-bucket

# OPA – mocked in unit tests; integration tests may spin up a real OPA instance
OPA_URL=http://localhost:8181
OPA_POLICY_PATH=/policies

# Dashboard
DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=5000
API_GATEWAY_URL=http://localhost:8000
KEYCLOAK_LOGIN_URL=http://localhost:8888/realms/forensics/protocol/openid-connect/auth

# Security
SECRET_KEY=test-secret-key
DEBUG=True
CORS_ORIGINS=*

# Logging
LOG_LEVEL=DEBUG
LOG_FORMAT=text
