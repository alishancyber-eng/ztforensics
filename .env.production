# ============================================================
# ZTForensics – Production Environment
# IMPORTANT: Replace ALL placeholder values before deploying.
# ============================================================

# Keycloak Configuration
KEYCLOAK_SERVER_URL=https://keycloak.example.com
KEYCLOAK_REALM=forensics
KEYCLOAK_CLIENT_ID=api-gateway
# Replace with a strong, randomly generated secret
KEYCLOAK_CLIENT_SECRET=REPLACE_WITH_STRONG_SECRET
KEYCLOAK_ADMIN_USER=admin
# Replace with a strong, unique password
KEYCLOAK_ADMIN_PASSWORD=REPLACE_WITH_STRONG_PASSWORD

# API Gateway
API_GATEWAY_HOST=0.0.0.0
API_GATEWAY_PORT=8000
API_GATEWAY_LOG_LEVEL=WARNING
JWT_ALGORITHM=RS256
TOKEN_EXPIRATION=3600

# Database – use a managed database service in production
DATABASE_URL=postgresql://ztf:REPLACE_WITH_STRONG_DB_PASSWORD@ztf-postgres:5432/ztfdb
DATABASE_POOL_SIZE=20
DATABASE_POOL_RECYCLE=1800

# MinIO Object Storage – consider S3-compatible cloud storage in production
MINIO_ENDPOINT=ztf-minio:9000
MINIO_ACCESS_KEY=REPLACE_WITH_STRONG_ACCESS_KEY
MINIO_SECRET_KEY=REPLACE_WITH_STRONG_SECRET_KEY
MINIO_BUCKET=forensics-evidence

# OPA Policy Engine
OPA_URL=http://ztf-opa:8181
OPA_POLICY_PATH=/policies

# Dashboard
DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=5000
API_GATEWAY_URL=http://ztf-api:8000
KEYCLOAK_LOGIN_URL=https://keycloak.example.com/realms/forensics/protocol/openid-connect/auth

# Security – strict in production
# Replace with a cryptographically random value (e.g. openssl rand -hex 32)
SECRET_KEY=REPLACE_WITH_RANDOM_SECRET_KEY
DEBUG=False
CORS_ORIGINS=https://app.example.com

# Logging
LOG_LEVEL=WARNING
LOG_FORMAT=json
